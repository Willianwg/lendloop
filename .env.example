# ---------------------------------------------------------------------------
# .env  (read by docker compose; created by scripts/setup.sh with random values)
# ---------------------------------------------------------------------------
# n8n's key for encrypting its stored credentials.
N8N_ENCRYPTION_KEY=
# HMAC secret for Convex -> n8n webhook calls. Also set in the Convex deployment env.
CONVEX_TO_N8N_SECRET=
# HMAC secret for n8n -> Convex HTTP actions. Also set in the Convex deployment env.
N8N_TO_CONVEX_SECRET=
# Optional: host ports (defaults shown) and compose project name, to run several stacks side by side.
# COMPOSE_PROJECT_NAME=lendloop
# CONVEX_PORT=3210
# CONVEX_SITE_PORT=3211
# CONVEX_DASHBOARD_PORT=6791
# N8N_PORT=5678
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# APP_PORT=3000

# ---------------------------------------------------------------------------
# .env.local  (read by Next.js and the Convex CLI; never committed)
# ---------------------------------------------------------------------------
# Convex backend URL used by the browser and by server components.
NEXT_PUBLIC_CONVEX_URL=
# Convex CLI target and admin key (scripts/setup.sh generates the key).
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
# Clerk keys (dashboard -> Configure -> API Keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Frontend API URL, e.g. https://verb-noun-00.clerk.accounts.dev (no trailing slash).
CLERK_JWT_ISSUER_DOMAIN=
